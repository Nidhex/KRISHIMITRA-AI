# ==========================================================================
# KrishiMitra AI — Environment Variables Template (.env.example)
# DO NOT include real API keys or credentials in this template.
# Copy this file to .env and fill in your environment configuration.
# ==========================================================================

# Port for KrishiMitra Node.js Express server
PORT=5001

# Sarvam AI API Key (For Multilingual 105b LLM Chat, Saaras STT & Bulbul TTS)
# Request key at: https://sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_MODEL=sarvam-105b

# Google Gemini API Key (Fallback LLM provider)
# Request key at: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Local Ollama LLM Config (Offline/Local Fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3

# Weather API Key (Optional, Open-Meteo is used by default)
WEATHER_API_KEY=

# News API Key (Optional, RSS / cached news database used by default)
NEWS_API_KEY=

# CORS Allowed Origin
CORS_ORIGIN=*

# Node Environment
NODE_ENV=production
